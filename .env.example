# ================================
# MassLoad Environment Variables
# ================================
# Copy this file to .env and fill in your values

# -------------------------
# Backend Configuration
# -------------------------

# Server port
PORT=3000

# -------------------------
# AI/Claude Configuration
# -------------------------

# Anthropic API key (required for AI transformation)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# -------------------------
# Logging Configuration
# -------------------------

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# -------------------------
# Optional: Blockchain Configuration
# -------------------------

# Allfeat node endpoint (used by frontend via config.js)
# NODE_ENDPOINT_URL=wss://node-dev.allfeat.io

# -------------------------
# Optional: Rate Limiting
# -------------------------

# Max requests per minute per IP (default: 10)
# RATE_LIMIT_PER_MINUTE=10
